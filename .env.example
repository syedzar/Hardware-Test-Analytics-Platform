# Copy this file to .env and fill in the values. .env is ignored by git.

# Data-access backend: sqlite (default) or oracle.
DB_BACKEND=sqlite

# SQLite database file (used when DB_BACKEND=sqlite).
HTAP_DB_PATH=test_data.db

# Oracle (used when DB_BACKEND=oracle, and by docker compose to create the
# database). Choose your own values; there are no defaults for the passwords.
ORACLE_USER=htap
ORACLE_PASSWORD=
ORACLE_SYSTEM_PASSWORD=
ORACLE_DSN=localhost:1521/FREEPDB1
